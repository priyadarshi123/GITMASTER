# Copy this file to .env and fill in your Angel One SmartAPI details.
# Leave blank to run on Yahoo Finance (delayed, no option chain).
#
# API key:     create an app at https://smartapi.angelone.in (type: Trading / Market feeds)
# Client code: your Angel One login ID
# MPIN:        your 4-digit Angel One MPIN
# TOTP secret: enable TOTP at https://smartapi.angelone.in/enable-totp and copy the
#              secret shown with the QR code (a base32 string, not the 6-digit code)

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Telegram alerts (Alerts page / settings.yaml `alerts:`)
# Bot token: message @BotFather on Telegram -> /newbot -> copy the token
# Chat id:   a public channel's @username (e.g. @my_option_alerts), or the numeric id
#            (-100...) for a private channel. Add the bot to the channel as an admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
